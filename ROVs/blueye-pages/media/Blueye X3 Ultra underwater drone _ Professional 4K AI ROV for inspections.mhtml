splay: block; padding-bottom: 1.5em; }

details summary { cursor: pointer; }

summary h5 { user-select: none; }

h1 { font-family: var(--font-cond); text-transform: uppercase; font-style: =
italic; font-weight: 500; font-size: 56px; line-height: 1; margin-bottom: 1=
rem; }

h2 { font-family: var(--font-cond); padding-top: 1rem; font-style: italic; =
font-weight: 600; font-size: 32px; line-height: 1; }

