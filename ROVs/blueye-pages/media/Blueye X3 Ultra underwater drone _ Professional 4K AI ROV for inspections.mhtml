@charset "utf-8";

* { box-sizing: border-box; padding: 0px; margin: 0px; outline: none; -webk=
it-font-smoothing: antialiased; }

body { font-family: var(--font-sans); font-size: 20px; line-height: 28px; b=
ackground-color: rgb(0, 56, 94); }

img { width: 100%; height: auto; }

a { color: rgb(0, 56, 94); }

a:hover { color: rgb(2, 232, 229); }

table { width: 100%; }

th { text-align: left; background-color: rgb(0, 56, 94); color: white; }

th, td { margin: 0px; padding: 6px 8px; }

td.right { text-align: right; }

